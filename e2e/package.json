{
  "name": "fsharp-viewengine-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:pr": "E2E_CROSS_BROWSER_MODE=focused playwright test --project=chromium --project=firefox --project=webkit",
    "test:release": "E2E_CROSS_BROWSER_MODE=full playwright test --project=chromium --project=firefox --project=webkit --retries=1",
    "test:published": "E2E_START_LOCAL=0 playwright test --project=chromium --retries=0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1"
  }
}
