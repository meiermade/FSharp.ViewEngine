  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FSharp.ViewEngine.Cli\FSharp.ViewEngine.Cli.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
