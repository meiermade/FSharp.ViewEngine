<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/node_modules/**;out/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Override the Web SDK defaults when assets are defined: keep browser refresh without
       Blazor initialization or filename collisions with the referencing web host. -->
  <Target Name="ConfigureHotReloadBrowserTools" BeforeTargets="_DefineHotReloadBrowserToolsAssetsCore">
    <PropertyGroup>
      <HotReloadBrowserToolsAssetPrefix>$(MSBuildProjectName).HotReload</HotReloadBrowserToolsAssetPrefix>
      <HotReloadBrowserToolsRegisterInitializerAsJSModule>false</HotReloadBrowserToolsRegisterInitializerAsJSModule>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Docs.Tests" />
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
    <ProjectReference Include="../Example.Components/Example.Components.fsproj" />
    <ProjectReference Include="../Example.Application/Example.Application.fsproj" />
    <PackageReference Include="Giraffe" Version="8.3.0" />
    <PackageReference Include="StarFederation.Datastar" Version="1.4.0" />
    <Compile Include="Config.fs" />
    <Compile Include="Services.fs" />
    <Compile Include="Common/Security.fs" />
    <Compile Include="Common/Navigation.fs" />
    <Compile Include="Common/Request.fs" />
    <Compile Include="Common/View.fs" />
    <Compile Include="Common/Handler.fs" />
    <Compile Include="Product/Session.fs" />
    <Compile Include="Product/Submission.fs" />
    <Compile Include="Product/Collection.fs" />
    <Compile Include="Product/Accounts/Handler.fs" />
    <Compile Include="Product/Transactions/Handler.fs" />
    <Compile Include="Product/Settings/Handler.fs" />
    <Compile Include="Product/Profile/Handler.fs" />
    <Compile Include="Product/Handler.fs" />
    <Compile Include="Specification/AppMode.fs" />
    <Compile Include="Specification/Architecture/Presentation.fs" />
    <Compile Include="Specification/Architecture/Context.fs" />
    <Compile Include="Specification/Architecture/Solution.fs" />
    <Compile Include="Specification/Architecture/Domain.fs" />
    <Compile Include="Specification/Architecture/Application.fs" />
    <Compile Include="Specification/Architecture/Components.fs" />
    <Compile Include="Specification/Architecture/Server.fs" />
    <Compile Include="Specification/Architecture/View.fs" />
    <Compile Include="Specification/Workflows/Workflow.fs" />
    <Compile Include="Specification/Workflows/Home.fs" />
    <Compile Include="Specification/Workflows/Accounts/ViewAccounts.fs" />
    <Compile Include="Specification/Workflows/Accounts/ViewAccount.fs" />
    <Compile Include="Specification/Workflows/Accounts/CreateAccount.fs" />
    <Compile Include="Specification/Workflows/Accounts/UpdateAccount.fs" />
    <Compile Include="Specification/Workflows/Accounts/DeleteAccount.fs" />
    <Compile Include="Specification/Workflows/Transactions/ViewTransactions.fs" />
    <Compile Include="Specification/Workflows/Transactions/ViewTransaction.fs" />
    <Compile Include="Specification/Workflows/Transactions/DeleteTransaction.fs" />
    <Compile Include="Specification/Workflows/Workspace.fs" />
    <Compile Include="Specification/Workflows/Settings.fs" />
    <Compile Include="Specification/Workflows/Profile.fs" />
    <Compile Include="Specification/Workflows/Overview.fs" />
    <Compile Include="Specification/View.fs" />
    <Compile Include="Specification/Handler.fs" />
    <Compile Include="ApiDocumentation/View.fs" />
    <Compile Include="ApiDocumentation/Handler.fs" />
    <Compile Include="Marketing/View.fs" />
    <Compile Include="Marketing/Handler.fs" />
    <Compile Include="../Presentation/View.fs" Link="Presentation/View.fs" />
    <Compile Include="Presentation/Handler.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="js/**/*.js" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="package.json;package-lock.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
