<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>FSharp.ViewEngine.Components</PackageId>
    <PackageVersion Condition="'$(FSharpViewEngineComponentsPackageVersion)' != ''">$(FSharpViewEngineComponentsPackageVersion)</PackageVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Andrew Meier</Authors>
    <Description>Shared primitives, application, and documentation UI for FSharp.ViewEngine with Tailwind and Datastar.</Description>
    <PackageTags>fsharp;html;components;tailwind;datastar;accessibility;server-rendered</PackageTags>
    <RepositoryUrl>https://github.com/meiermade/FSharp.ViewEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <Target Name="ValidateComponentsPackageVersions" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(FSharpViewEngineComponentsPackageVersion)' == ''" Text="Packing FSharp.ViewEngine.Components requires /p:FSharpViewEngineComponentsPackageVersion=YYYY.M.MINOR. Use the package release workflow for publication." />
    <Error Condition="'$(FSharpViewEnginePackageVersion)' == ''" Text="Packing FSharp.ViewEngine.Components requires /p:FSharpViewEnginePackageVersion=YYYY.M.MINOR for its minimum Core dependency. Use the package release workflow for publication." />
  </Target>
  <ItemGroup>
    <Compile Include="Foundation.fs" />
    <Compile Include="Button.fs" />
    <Compile Include="IconButton.fs" />
    <Compile Include="Badge.fs" />
    <Compile Include="Status.fs" />
    <Compile Include="LoadingIndicator.fs" />
    <Compile Include="EmptyState.fs" />
    <Compile Include="Table.fs" />
    <Compile Include="BulkActions.fs" />
    <Compile Include="DescriptionList.fs" />
    <Compile Include="Metric.fs" />
    <Compile Include="Pagination.fs" />
    <Compile Include="ChoiceSelection.fs" />
    <Compile Include="TextField.fs" />
    <Compile Include="Select.fs" />
    <Compile Include="Notice.fs" />
    <Compile Include="Checkbox.fs" />
    <Compile Include="Switch.fs" />
    <Compile Include="ToggleButton.fs" />
    <Compile Include="Tabs.fs" />
    <Compile Include="RadioGroup.fs" />
    <Compile Include="DropdownMenu.fs" />
    <Compile Include="Actions.fs" />
    <Compile Include="Dialog.fs" />
    <Compile Include="Breadcrumbs.fs" />
    <Compile Include="SideNav.fs" />
    <Compile Include="BottomNavigation.fs" />
    <Compile Include="Page.fs" />
    <Compile Include="Section.fs" />
    <Compile Include="Compositions.fs" />
    <Compile Include="AppShell.fs" />
    <Compile Include="PreviewFrame.fs" />
    <Compile Include="Browser.fs" />
    <Compile Include="Phone.fs" />
    <Compile Include="Documentation/ValidationIssue.fs" />
    <Compile Include="Documentation/SequenceDiagram.fs" />
    <Compile Include="Documentation/Target.fs" />
    <Compile Include="Documentation/Navigation.fs" />
    <Compile Include="Documentation/Document.fs" />
    <Compile Include="Documentation/ApiReference.fs" />
    <Compile Include="Documentation/Example.fs" />
    <Compile Include="Documentation/Fixture.fs" />
    <Compile Include="Documentation/Registry.fs" />
    <Compile Include="Documentation/Search.fs" />
    <Compile Include="Documentation/Version.fs" />
    <Compile Include="Documentation/View.fs" />
    <Compile Include="Documentation/DirectedGraph.fs" />
    <None Include="../../../LICENSE" Pack="True" Visible="false" PackagePath="" />
    <None Include="README.md" Pack="True" Visible="false" PackagePath="" />
    <None Include="FSharp.ViewEngine.Components.tailwind.css" Pack="True" PackagePath="contentFiles/any/any" PackageCopyToOutput="false" />
    <None Include="AppMode.tailwind.css" Pack="True" PackagePath="contentFiles/any/any" PackageCopyToOutput="false" />
    <None Include="app-mode.js" Pack="True" PackagePath="contentFiles/any/any" PackageCopyToOutput="false" />
    <None Include="Documentation/Documentation.tailwind.css" Pack="True" PackagePath="contentFiles/any/any/Documentation" PackageCopyToOutput="false" />
    <None Include="Documentation/README.md" Pack="True" PackagePath="Documentation" />
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FSharp.ViewEngine\FSharp.ViewEngine.fsproj" />
  </ItemGroup>
</Project>
