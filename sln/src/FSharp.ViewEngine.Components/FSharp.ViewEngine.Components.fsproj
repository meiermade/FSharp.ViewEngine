<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>FSharp.ViewEngine.Components</PackageId>
    <PackageVersion Condition="'$(FSharpViewEngineComponentsPackageVersion)' != ''">$(FSharpViewEngineComponentsPackageVersion)</PackageVersion>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Andrew Meier</Authors>
    <Description>Accessible, server-rendered Tailwind components for FSharp.ViewEngine with Datastar interactions.</Description>
    <PackageTags>fsharp;html;components;tailwind;datastar;accessibility;server-rendered</PackageTags>
    <RepositoryUrl>https://github.com/meiermade/FSharp.ViewEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <Target Name="ValidateComponentsPackageVersions" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(FSharpViewEngineComponentsPackageVersion)' == ''" Text="Packing FSharp.ViewEngine.Components requires /p:FSharpViewEngineComponentsPackageVersion=YYYY.M.MINOR. Use the package release workflow for publication." />
    <Error Condition="'$(FSharpViewEnginePackageVersion)' == ''" Text="Packing FSharp.ViewEngine.Components requires /p:FSharpViewEnginePackageVersion=YYYY.M.MINOR for its minimum Core dependency. Use the package release workflow for publication." />
  </Target>
  <ItemGroup>
    <Compile Include="Foundation.fs" />
    <Compile Include="Button.fs" />
    <Compile Include="IconButton.fs" />
    <Compile Include="Badge.fs" />
    <Compile Include="Status.fs" />
    <Compile Include="LoadingIndicator.fs" />
    <Compile Include="EmptyState.fs" />
    <Compile Include="Table.fs" />
    <Compile Include="Select.fs" />
    <Compile Include="Combobox.fs" />
    <Compile Include="Checkbox.fs" />
    <Compile Include="Switch.fs" />
    <Compile Include="ToggleButton.fs" />
    <Compile Include="RadioGroup.fs" />
    <Compile Include="DropdownMenu.fs" />
    <Compile Include="Dialog.fs" />
    <Compile Include="Compositions.fs" />
    <Compile Include="AppShell.fs" />
    <None Include="../../../LICENSE" Pack="True" Visible="false" PackagePath="" />
    <None Include="README.md" Pack="True" Visible="false" PackagePath="" />
    <None Include="FSharp.ViewEngine.Components.tailwind.css" Pack="True" PackagePath="contentFiles/any/any" PackageCopyToOutput="false" />
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FSharp.ViewEngine\FSharp.ViewEngine.fsproj" />
  </ItemGroup>
</Project>
